{
  "name": "m-xterm",
  "private": true,
  "version": "0.1.17",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:mcp-sidecar": "cargo build --manifest-path src-tauri/Cargo.toml --release --bin mxterm-mcp",
    "check": "tsc --noEmit",
    "check:connection-transfer": "node scripts/check-connection-transfer-source.mjs",
    "check:duplicate-connection": "node scripts/check-duplicate-connection-source.mjs",
    "check:middle-click-tabs": "node scripts/check-middle-click-close-tabs-source.mjs",
    "check:tauri-capabilities": "node scripts/check-tauri-capabilities.mjs",
    "check:tauri-csp": "node scripts/check-tauri-csp.mjs",
    "check:secrets": "node scripts/security-check.mjs secrets",
    "audit:npm": "node scripts/security-check.mjs npm",
    "audit:rust": "node scripts/security-check.mjs rust",
    "package:win": "node scripts/build-platform.mjs win-x64",
    "package:mac-arm64": "node scripts/build-platform.mjs mac-arm64",
    "package:linux": "node scripts/build-platform.mjs linux-x64",
    "package:all": "node scripts/build-platform.mjs all",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:release": "node --test scripts/build-platform.test.mjs scripts/release-assets.test.mjs scripts/generate-latest-json.test.mjs",
    "check:ironrdp-macos-prototype": "node scripts/check-ironrdp-macos-prototype.mjs",
    "check:rdp-release-readiness": "node scripts/check-rdp-release-readiness.mjs",
    "prototype:ironrdp-viewer": "node scripts/prototype-ironrdp-viewer.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev"
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dismissable-layer": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.47.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.31.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
